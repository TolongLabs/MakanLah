# MakanLah. Copy to .env and fill. Never commit .env.
#
# An empty value means "the name is settled, the secret is yours". A
# <placeholder> means the name itself is not yet confirmed — verify it against
# the provider's own docs before pinning.

# --- Persistence -------------------------------------------------------------

# Neon. Postgres + pgvector, one store for rows, full-text and vectors.
# Pick a region near KL (ap-southeast-1) — every request path crosses it.
# Use the POOLED connection string for the API and the DIRECT one for
# migrations; pgbouncer does not support the statements migrations issue.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Ingestion ---------------------------------------------------------------

# Firecrawl. ~20k credits available. Likely bounces off login-walled Xiaohongshu
# content; kept because it is the cheap path for the open-web fallback sources.
FIRECRAWL_API_KEY=

# Scrapling drives an authenticated browser session rather than an API key.
# Point this at a Chrome profile that is already signed in — see
# docs/CREDENTIALS.md. Never copy the profile into the repo; a cookie jar is a
# live credential.
XHS_CHROME_PROFILE=
XHS_CHROME_PROFILE_DIR=Default

# Chrome DevTools Protocol endpoint, if attaching to an already-running Chrome
# rather than launching one. localhost only — this port IS the session.
XHS_CDP_URL=http://127.0.0.1:9222

# --- Geocoding ---------------------------------------------------------------
# Runs at INGESTION time, never on the request path: geocode once per restaurant,
# store the coordinates, and the request path does pure arithmetic. That is why
# a 1-request-per-second free service is entirely adequate here.

# Nominatim (OpenStreetMap). No key, no billing. Its usage policy requires a
# real contact address in the User-Agent and one request per second.
NOMINATIM_USER_AGENT=MakanLah/0.1 (<your-contact-email>)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Google Places — the fallback, only if Nominatim's match rate on mixed-language
# Malaysian restaurant names proves poor. Needs a Cloud project with billing
# enabled even inside the free tier. Its place_id also sharpens the directions
# deep link, which disambiguates a chain with twenty branches.
GOOGLE_PLACES_API_KEY=

# --- Models ------------------------------------------------------------------
# Two jobs with opposite characteristics, deliberately not sharing a provider.

# Extraction: post text (EN/MS/ZH, often mixed) -> structured fields. Batch,
# high volume, nobody waiting. ModelScope serves Qwen, which is materially
# better on Chinese than most alternatives, and the corpus is Xiaohongshu.
# China-hosted, so latency is real — fine for batch, disqualifying interactively.
# OpenAI-compatible; verify the base path against ModelScope's own docs.
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# Model ids are case- and slash-sensitive. Verify against the provider's model
# list with your own key before pinning.
MODELSCOPE_MODEL_EXTRACT=<pick a Qwen instruct model from ModelScope's catalog>

# Embeddings. The one row with no default: EN/MS/ZH code-switching is risk #3 in
# docs/PRODUCT.md, and a model weak on one language biases retrieval silently.
# Decide this by measurement — see docs/superpowers/research/. Check whether the
# ModelScope quota covers a Qwen embedding model before paying for another.
EMBEDDING_PROVIDER=<modelscope | cohere | local-bge-m3>
EMBEDDING_MODEL=<confirm>
COHERE_API_KEY=

# Re-rank: top-50 -> top-10, attaching citations. Interactive, a user is waiting.
# Keep this on the lowest-latency option available; not ModelScope.
HERMES_API_KEY=<confirm against the Hermes Agent docs before pinning>
HERMES_COPILOT_BASE_URL=<confirm>
HERMES_INGEST_BASE_URL=<confirm>

# --- Workers -----------------------------------------------------------------

# OpenRouter, for GLM-5.3-Flash. Fallback worker lane today, primary after the
# Devin free tier lapses on 2026-09-23. Promo pricing ends 2026-09-09.
# Parse the .error field explicitly — GLM returns empty .choices[] on failure and
# a harness reading only the content field records that as a success. SWARM.md §7.
OPENROUTER_API_KEY=

# `devin` authenticates through its own CLI login, not through this file.
# Nothing to set here; the line exists so nobody goes looking for it.

# --- App ---------------------------------------------------------------------

# Public origin of the API, for the client's CORS and fetch base.
# Directions need NO key: the MVP deep-links to Google Maps rather than
# rendering one. See docs/TRD.md.
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- DashScope (Alibaba) -----------------------------------------------------
# The extraction lane actually in use. ModelScope above was the pre-spike
# assumption and no key for it exists; the owner holds an International/Singapore
# DashScope key with free quota. Singapore is materially nearer KL than the
# China-hosted ModelScope endpoint, and text-embedding-v3 is genuinely
# multilingual, which is the EN/MS/ZH silent-bias risk in docs/PRODUCT.md.
# OpenAI-compatible, so the client is the same one ModelScope would have used.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_EXTRACT=qwen-plus-2025-07-28
DASHSCOPE_MODEL_EMBED=text-embedding-v3
