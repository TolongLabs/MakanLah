# MakanLah. Copy to .env and fill. Never commit .env.
#
# Most of this file is provisional. The scraper stack is an open decision in
# docs/PRODUCT.md and the spike resolves it — expect keys to be added or dropped
# once it returns. An empty value here means "the name is settled, the secret is
# yours"; a <placeholder> means the name itself is not yet confirmed.

# --- Ingestion ---------------------------------------------------------------

# Firecrawl. ~20k credits available. Likely bounces off login-walled Xiaohongshu
# content; kept because it is the cheap path for the open-web fallback sources.
FIRECRAWL_API_KEY=

# Scrapling drives an authenticated browser session rather than an API key.
# Point this at a session/profile path outside the repo — *.session is gitignored,
# but a cookie jar has no business near a git tree at all.
XHS_SESSION_PATH=

# --- Agent runtimes ----------------------------------------------------------
# Two workloads, deliberately not sharing a runtime. See docs/PRODUCT.md.
# Interactive copilot: a user is waiting. Batch ingestion: nobody is.

HERMES_API_KEY=<confirm against the Hermes Agent docs before pinning>
HERMES_COPILOT_BASE_URL=<confirm>
HERMES_INGEST_BASE_URL=<confirm>

# --- Workers -----------------------------------------------------------------

# OpenRouter, for GLM-5.3-Flash. Fallback worker lane today, primary after the
# Devin free tier lapses on 2026-09-23. Promo pricing ends 2026-09-09.
# Parse the .error field explicitly — GLM returns empty .choices[] on failure and
# a harness reading only the content field records that as a success. SWARM.md §7.
OPENROUTER_API_KEY=

# `devin` authenticates through its own CLI login, not through this file.
# Nothing to set here; the line exists so nobody goes looking for it.

# --- App ---------------------------------------------------------------------

# Maps/directions handoff. Provider not chosen; the MVP hands off rather than
# rendering, so this may end up unused.
MAPS_API_KEY=<confirm once the directions handoff is chosen>
