# Dependencies
node_modules/

# Build output
dist/
build/
.next/
.output/
*.tsbuildinfo

# Caches
.cache/
.turbo/
.vite/

# Python. No Python stack yet; the scrape spike is the first thing that creates one
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Scraped content. The normalized corpus and anything raw stay local: volume,
# and platform terms. Schemas and fixtures are committed, harvests are not.
data/raw/
data/corpus/
*.session

# Editor and OS
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp

# Logs
logs/
*.log

# Agent local state
.claude/settings.local.json
.claude/projects/
.planning/**/*.local.md

# skills.sh writes this universal tree; we install with -a claude-code only
/agent/

# Derived

# Raw recordings. Transcripts under docs/source/ are committed
docs/source/*.mp3
docs/source/*.mp4
docs/source/*.wav
docs/source/*.m4a
docs/source/*.webm

# Playwright MCP scratch: snapshots and console logs from driving the browser
.playwright-mcp/

# Live2D model binaries. The LiveroiD moc3, textures and expressions are a BOOTH
# download under the Live2D proprietary licence, and the texture alone is 31 MB.
# Drop them in per web/public/models/README.md; the app runs without them.
# The LiveroiD Live2D model. Gitignored until 2026-08-29, when the owner took the
# licensing call explicitly: personal project, their risk. It has to be in the repo to
# reach the build, because CI has no other source for it and the deploy job was
# shipping the text fallback every time as a result.
# web/public/models/liveroid/

# Graphify rebuild cache. The graph itself is committed; this is content-hashed AST
# scratch pinned to a graphify version, regenerated by `graphify . --update`.
graphify-out/cache/

# Demo video artefacts. The pipeline that makes them is committed; the output is not.
*.mp4
*.webm
*.wav

# Rendered screenshots. Regenerated on demand by scripts/screenshots.py, and a
# binary set that churns on every visual change does not belong in review.
docs/screenshots/

# Written by `vercel link`. .vercel holds the project id and a short-lived OIDC
# token; .env* is already covered above and is repeated here only because the
# CLI appends it unconditionally.
.vercel

# Local working notes. Untracked but not ignored, a scratch dir turns `bun run
# lint` red through the `**/*.md` glob while CI stays green on its clean
# checkout -- a gate that fails only on the machine doing the work.
scratchpad/
