{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["makanlah/**", "api/**"], "maxDuration": 60 }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }]
}
